# Copy to .env and fill in. Never commit .env.
TUSHARE_TOKEN=
QUANT_TOKEN=change-me-local-only
QUANT_PORT=8811
MODE=paper
# Account size lives in configs/params.yaml (risk.initial_cash). A temporary
# override is QUANT__RISK__INITIAL_CASH=6000 — it shows up in
# /health.config.overridden. INITIAL_CASH is no longer read.

# Realtime quotes: 1 = allow vendor calls, 0 = stored daily bars only.
REALTIME_QUOTES=1

# Tonghuashun (iFinD / fuyao) official A-share data. Free key at
# https://fuyao.aicubes.cn/admin. Leave empty to disable.
THS_API_KEY=
THS_BASE_URL=https://fuyao.aicubes.cn

# STOP_TRIGGER is gone on purpose. A stop no longer triggers anything: the kernel
# reports the close-vs-stop distance and, separately, whether the session pierced
# the stop intraday and recovered. Both facts are always available, so there is
# no mode to choose - and no setting that turns a report into a sell order.

# Fill basis. next_open (default) = a decision made after the close executes at
# the next session's open, which is the only honest price for a decision written
# on yesterday's data. intraday = fill against the live quote when a session is
# open, labelled fill_basis="intraday" because it cannot be reproduced later.
# Intraday falls back to the next open when the market is closed, and refuses
# outright when no live quote exists (it will not price off a stale close).
FILL_MODE=next_open
