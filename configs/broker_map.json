{
  "_help": [
    "券商导出格式各家不同，所以列名不写死在代码里，写在这里。",
    "加一个券商：复制 profiles.trades，把它的列名放进对应字段的别名数组即可，不用改代码。",
    "程序先在前 12 行里找表头（有些导出带标题行），再用 required 里的字段能否全部命中来选 profile。",
    "解析失败时会把真实表头原样打印出来 —— 看到表头就能补别名，不用猜。"
  ],
  "profiles": {
    "trades": {
      "kind": "trades",
      "required": ["trade_date", "symbol", "side", "qty", "price"],
      "columns": {
        "trade_date": ["成交日期", "发生日期", "交易日期", "日期", "trade_date", "date"],
        "trade_time": ["成交时间", "发生时间", "委托时间", "时间", "time"],
        "symbol": ["证券代码", "股票代码", "证券编码", "代码", "symbol", "ts_code"],
        "side": ["买卖标志", "买卖方向", "买卖类型", "操作", "操作类型", "业务名称",
                 "委托类别", "交易方向", "买卖", "摘要", "side"],
        "qty": ["成交数量", "成交股数", "成交量", "发生数量", "数量", "qty", "volume"],
        "price": ["成交价格", "成交均价", "发生价格", "价格", "price"],
        "amount": ["成交金额", "发生金额", "成交额", "金额", "amount"],
        "fee": ["手续费", "佣金", "交易费用", "费用合计", "总费用", "fee", "commission"],
        "stamp": ["印花税"],
        "transfer": ["过户费", "过户费/结算费"],
        "broker_id": ["成交编号", "合同编号", "委托编号", "流水号", "成交序号", "broker_id"]
      },
      "side_values": {
        "买入": "BUY", "证券买入": "BUY", "买": "BUY", "担保品买入": "BUY", "B": "BUY", "BUY": "BUY",
        "卖出": "SELL", "证券卖出": "SELL", "卖": "SELL", "担保品卖出": "SELL", "S": "SELL", "SELL": "SELL"
      }
    },
    "positions": {
      "kind": "positions",
      "required": ["symbol", "qty"],
      "columns": {
        "symbol": ["证券代码", "股票代码", "代码", "证券编码", "symbol", "ts_code"],
        "qty": ["实际数量", "当前拥股", "拥股数量", "股票余额", "证券数量", "当前持仓",
                "持仓数量", "股份余额", "持股数量", "数量", "qty"],
        "available": ["可用余额", "可用数量", "可卖数量", "可用股份", "可卖股数", "可用股数"],
        "cost": ["参考成本价", "成本价", "持仓成本", "摊薄成本价", "买入均价", "持仓均价",
                 "平均成本", "cost"],
        "market_value": ["参考市值", "市值", "最新市值", "market_value"],
        "name": ["证券名称", "股票名称", "名称", "name"]
      },
      "_qty_note": "实际数量优先于股票余额：同花顺/中信建投的持仓表里，当日卖出的票仍然显示股票余额，只把实际数量置 0、冻结数量置为全部。按股票余额记，账上会凭空多出一笔已经卖掉的持仓。"
    }
  }
}
